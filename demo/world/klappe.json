    "scenes": [
      {
        "id": "szene-014",
        "number": "14",
        "heading": {
          "de": "INT. LEUCHTTURM GRAUFELD – WACHRAUM – NACHT",
          "en": "INT. GRAUFELD LIGHTHOUSE – WATCH ROOM – NIGHT"
        },
        "location": "leuchtturm",
        "note": "Ilva finds a page in her own hand that she never wrote (the manuscript page 19 of the hidden layer, quoted as it is in oddities). The light goes out for the count of seven, and she is gone. Fountain-ready: each `say` becomes a character cue, an optional `paren` and a dialogue.",
        "script": [
          {
            "id": "auftakt",
            "action": {
              "de": "Nacht. Nebel drückt gegen die Scheiben. Eine Frau sitzt am Tisch, vor sich einen Stapel Seiten. Die Tür zur Galerie geht auf. Der Wärter tritt ein, Nebel an den Schultern.",
              "en": "Night. Fog presses against the panes. A woman sits at the table, a stack of pages in front of her. The door to the gallery opens. The keeper steps in, fog on his shoulders."
            }
          },
          {
            "id": "verbot",
            "say": "waerter",
            "text": {
              "de": "Hier oben darf nachts niemand sein.",
              "en": "Nobody is allowed up here at night."
            }
          },
          {
            "id": "seite",
            "say": "ilva",
            "paren": {"de": "ohne aufzusehen", "en": "without looking up"},
            "text": {
              "de": "Ich weiß. Diese Seite lag schon da. In meiner Schrift. Ich habe sie nie geschrieben.",
              "en": "I know. This page was already here. In my handwriting. I never wrote it."
            }
          },
          {
            "say": "waerter",
            "text": {"de": "Was steht darauf?", "en": "What does it say?"}
          },
          {
            "id": "vorlesen",
            "say": "ilva",
            "paren": {"de": "liest", "en": "reading"},
            "text": "{{oddities.manuscript_pages.3.text}}"
          },
          {
            "say": "waerter",
            "text": {"de": "Das Feuer erlischt nie.", "en": "The fire never goes out."}
          },
          {
            "id": "dunkel",
            "action": {
              "de": "Über ihnen wandert der Lichtkegel durch den Raum. Dann erlischt er. Niemand rührt sich.",
              "en": "Above them the beam sweeps through the room. Then it goes out. Nobody moves."
            }
          },
          {
            "id": "zaehlen",
            "say": "ilva",
            "paren": {"de": "flüsternd", "en": "whispering"},
            "text": {"de": "Eins. Zwei. Drei. Vier.", "en": "One. Two. Three. Four."}
          },
          {
            "id": "leer",
            "action": {
              "de": "Das Licht kehrt zurück. Der Stuhl ist leer. Die Seite liegt noch auf dem Tisch.",
              "en": "The light returns. The chair is empty. The page is still on the table."
            }
          }
        ],
